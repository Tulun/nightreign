  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/pngjs": "^6.0.5",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.35",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "tsx": "^4.23.1",
    "typescript": "5.5.3"
