{
  "name": "nightreign-reference",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:fake": "NEXT_PUBLIC_FAKE_CLOUD=1 next dev",
    "build": "next build",
    "build:pages": "GITHUB_PAGES=true next build",
